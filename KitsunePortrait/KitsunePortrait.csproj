<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>KitsunePortrait</AssemblyName>
        <RootNamespace>KitsunePortrait</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
        <AssemblySearchPaths>$(WOTR_PATH)\Wrath_Data\Managed\;$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\;$(AssemblySearchPaths)</AssemblySearchPaths>

        <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Нужен для GUIStyle/GUI.Box/TextAnchor и прочего legacy IMGUI, которое использует оверлей. -->
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityModManager">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\UnityModManager.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="Owlcat.Runtime.UI">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\Owlcat.Runtime.UI.dll</HintPath>
            <Private>False</Private>
        </Reference>

    </ItemGroup>

    <Target Name="DeployMod" AfterTargets="Build">
        <PropertyGroup>
            <ModFolder>$(WOTR_PATH)\Mods\$(AssemblyName)</ModFolder>
        </PropertyGroup>

        <Message Importance="High" Text="Начало деплоя мода в: $(ModFolder)" />
        <MakeDir Directories="$(ModFolder)" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModFolder)" />
        <Copy SourceFiles="Info.json" DestinationFolder="$(ModFolder)" />
        <Message Importance="High" Text="Мод успешно скопирован и готов к запуску!" />
    </Target>
</Project>